{
  "name": "whatsmybudget-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for WhatsMyBudget Analytics API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "fastmcp": "^4.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
